%% PawPal+ system overview: components, data flow, and where humans and tests check the AI.
%% Colours: blue = human, purple = AI, green = deterministic code, orange = guardrail/check, grey = testing.
flowchart TB
    %% ---------------- Human input ----------------
    subgraph INPUT["👤 Owner (Streamlit app.py)"]
        direction LR
        H_REQ["Plan with AI<br/>free-text day description"]
        H_QUICK["Quick add<br/>e.g. 'evening walk 30 min'"]
        H_FORM["Manual forms<br/>pets and tasks"]
    end

    %% ---------------- Input guardrails ----------------
    subgraph GUARD_IN["🛡️ Input guardrails (guardrails.py)"]
        G_CLEAN["Clean text + length caps"]
        G_INJ{"Prompt injection?"}
        G_URG{"Emergency words?"}
        G_RATE{"Rate limit<br/>10 AI calls / 5 min"}
    end

    H_REQ --> G_CLEAN
    H_QUICK -->|length cap only| G_CLEAN
    G_CLEAN --> G_INJ
    G_INJ -->|yes| BLOCK["Refused with a message<br/>model never called"]
    G_INJ -->|no| G_URG
    G_URG -->|yes| BANNER["🚨 'Call your vet now' banner<br/>request still continues"]
    G_URG --> G_RATE
    G_RATE -->|over limit| WAIT["Asked to wait"]

    %% ---------------- AI planner ----------------
    subgraph AGENT["🤖 Planning agent (agent.py)"]
        PA["PlanningAgent loop<br/>plan → act → check<br/>max 15 steps, 12 calls/turn,<br/>stops after 3 repeated errors"]
        GEM["Gemini (GeminiClient)<br/>falls back to a lite model<br/>when overloaded"]
        TOOLS["PlannerTools<br/>7 validated tools<br/>on a copy of the pets"]
        PA <-->|messages / tool calls| GEM
        PA -->|dispatch| TOOLS
    end

    %% ---------------- Trained model ----------------
    subgraph MODEL["⚡ Trained task model (task_model.py)"]
        DATA[("data/task_dataset.csv<br/>219 labelled tasks")]
        TM["TaskModel<br/>TF-IDF + logistic regression<br/>priority · minutes · frequency"]
        DATA -->|trained at startup| TM
    end

    %% ---------------- Deterministic core ----------------
    subgraph CORE["⚙️ Deterministic core (scheduler.py)"]
        PETS[("Owner → Pets → Tasks<br/>session_state")]
        SCHED["Scheduler.build_plan<br/>sort · fit budget · pin fixed times<br/>detect conflicts · recurrence"]
        PETS --> SCHED
    end

    G_RATE -->|plan request| PA
    G_CLEAN -->|quick add text| TM
    TOOLS -->|build_plan| SCHED
    TM -->|predicted labels| PETS
    H_FORM --> PETS

    %% ---------------- Output checks ----------------
    subgraph GUARD_OUT["✅ Automated checks on AI output"]
        POST["Independent post-check<br/>rebuild plan; flag skipped high-priority,<br/>clashes, step cap, no tasks"]
        SECOND["Second opinion<br/>TaskModel disagrees on priority<br/>with ≥ 70% confidence"]
        CAP["Clean + cap explanation length"]
    end

    PA -->|finish| POST
    POST --> CAP
    POST --> SECOND
    TM -.->|re-labels agent tasks| SECOND

    %% ---------------- Human review ----------------
    subgraph REVIEW["👀 Human review of AI results"]
        R_WHY["'Why this plan?'<br/>agent steps + second opinions"]
        R_COMMIT["Agent's pets committed<br/>only on success"]
        R_TODAY["📅 Today plan<br/>didn't-fit + clash warnings,<br/>tick tasks done"]
        R_EDIT["Manage tasks editor<br/>fix priority / minutes / times"]
    end

    CAP --> R_COMMIT
    SECOND --> R_WHY
    R_COMMIT --> PETS
    R_COMMIT --> R_WHY
    SCHED --> R_TODAY
    R_TODAY --> R_EDIT
    R_EDIT -->|edits| PETS

    %% ---------------- Testing & observability ----------------
    subgraph TEST["🧪 Testing & observability"]
        T_UNIT["pytest: 141 tests<br/>FakeLLM scripts the agent"]
        T_APP["Streamlit AppTest<br/>end-to-end UI, no API key"]
        T_EVAL["python -m task_model<br/>accuracy vs baseline,<br/>confidence vs accuracy"]
        T_LIVE["eval_live.py<br/>real Gemini runs,<br/>rated by a person"]
        T_LOG[("logs/pawpal.log<br/>run IDs, tool calls,<br/>step times, guardrail hits")]
    end

    T_UNIT -.->|verifies| PA
    T_UNIT -.->|verifies| GUARD_IN
    T_UNIT -.->|verifies| GUARD_OUT
    T_UNIT -.->|verifies| SCHED
    T_APP -.->|verifies| INPUT
    T_EVAL -.->|measures| TM
    T_LIVE -.->|rates| PA
    PA -.->|logs| T_LOG
    G_INJ -.->|logs| T_LOG

    %% ---------------- Styles ----------------
    classDef human fill:#dbeafe,stroke:#2563eb,color:#1e3a8a
    classDef ai fill:#ede9fe,stroke:#7c3aed,color:#4c1d95
    classDef code fill:#dcfce7,stroke:#16a34a,color:#14532d
    classDef check fill:#ffedd5,stroke:#ea580c,color:#7c2d12
    classDef test fill:#f3f4f6,stroke:#6b7280,color:#111827
    classDef stop fill:#fee2e2,stroke:#dc2626,color:#7f1d1d

    class H_REQ,H_QUICK,H_FORM,R_WHY,R_COMMIT,R_TODAY,R_EDIT,T_LIVE human
    class PA,GEM,TM ai
    class DATA,PETS,SCHED,TOOLS code
    class G_CLEAN,G_INJ,G_URG,G_RATE,POST,SECOND,CAP check
    class T_UNIT,T_APP,T_EVAL,T_LOG test
    class BLOCK,BANNER,WAIT stop
